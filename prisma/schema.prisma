generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectMode {
  SLIDESHOW
  HTML_ANIMATION
}

enum ProjectStatus {
  DRAFT
  INITIALIZING
  GENERATING
  READY
  FAILED
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  HTML
  JSON
  THUMBNAIL
}

enum TaskType {
  INITIALIZE_PROJECT
  GENERATE_STORYBOARD
  GENERATE_ASSET
  RENDER_VIDEO
  EXPORT_VIDEO
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Project {
  id              String            @id @default(uuid()) @db.Uuid
  title           String
  mode            ProjectMode
  status          ProjectStatus     @default(DRAFT)
  durationMs      Int               @default(0)
  thumbnailAssetId String?          @db.Uuid
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  settings        ProjectSetting?
  scenes          StoryboardScene[]
  tracks          TimelineTrack[]
  clips           TimelineClip[]
  assets          Asset[]
  generationTasks GenerationTask[]
  versions        ProjectVersion[]

  @@index([updatedAt])
  @@index([mode])
  @@index([status])
  @@map("projects")
}

model ProjectSetting {
  projectId              String   @id @db.Uuid
  aspectRatio            String   @default("16:9")
  width                  Int      @default(1920)
  height                 Int      @default(1080)
  fps                    Int      @default(30)
  defaultSceneDurationMs Int      @default(5000)
  theme                  Json     @default("{}")
  aiConfig               Json     @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model StoryboardScene {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  sceneIndex      Int
  title           String
  prompt          String   @default("")
  narration       String   @default("")
  startMs         Int      @default(0)
  durationMs      Int      @default(5000)
  thumbnailAssetId String? @db.Uuid
  visualConfig    Json     @default("{}")
  animationConfig Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips           TimelineClip[]

  @@unique([projectId, sceneIndex])
  @@index([projectId, sceneIndex])
  @@map("storyboard_scenes")
}

model TimelineTrack {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  name       String
  trackType  String
  trackIndex Int
  config     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips      TimelineClip[]

  @@unique([projectId, trackIndex])
  @@index([projectId, trackIndex])
  @@map("timeline_tracks")
}

model TimelineClip {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  trackId    String   @db.Uuid
  sceneId    String?  @db.Uuid
  assetId    String?  @db.Uuid
  startMs    Int
  durationMs Int
  clipIndex  Int
  config     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  track      TimelineTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  scene      StoryboardScene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([projectId, startMs])
  @@index([trackId, clipIndex])
  @@map("timeline_clips")
}

model Asset {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  type       AssetType
  url        String?
  storageKey String?
  mimeType   String?
  width      Int?
  height     Int?
  durationMs Int?
  sizeBytes  BigInt?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("assets")
}

model GenerationTask {
  id           String     @id @default(uuid()) @db.Uuid
  projectId    String     @db.Uuid
  type         TaskType
  status       TaskStatus @default(QUEUED)
  progress     Int        @default(0)
  input        Json       @default("{}")
  output       Json       @default("{}")
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("generation_tasks")
}

model ProjectVersion {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  version   Int
  label     String?
  snapshot  Json
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@map("project_versions")
}

