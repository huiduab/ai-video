# PostgreSQL connection
# Copy this file to .env.local and fill in your real values.
DATABASE_URL="postgresql://postgres:password@localhost:5432/motionweave_ai?schema=public"

# Optional direct connection for migration tools when using a pooler.
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/motionweave_ai?schema=public"

# Runtime configuration
APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI-compatible model provider for the video creation Agent.
AI_BASE_URL="https://your-provider.example.com/v1"
AI_API_KEY="your_api_key"
AI_MODEL="gemini-3-flash-preview"

# Director model for script/storyboard generation. Defaults target DeepSeek official API.
DIRECTOR_API_BASE_URL="https://api.deepseek.com"
DIRECTOR_API_KEY="your_deepseek_api_key"
DIRECTOR_MODEL="deepseek-v4-pro"
DIRECTOR_REQUEST_TIMEOUT_MS="90000"

# HTML layout planner runs after the script director and plans per-scene motion/layout.
# Defaults reuse the director provider and run 4 scene planning requests concurrently.
HTML_LAYOUT_API_BASE_URL="https://api.deepseek.com"
HTML_LAYOUT_API_KEY="your_deepseek_api_key"
HTML_LAYOUT_MODEL="deepseek-v4-pro"
HTML_LAYOUT_REQUEST_TIMEOUT_MS="90000"
HTML_LAYOUT_CONCURRENCY="4"

# HTML motion executor. Defaults target DeepSeek-compatible chat completions.
HTML_API_BASE_URL="https://api.deepseek.com"
HTML_API_KEY="your_deepseek_api_key"
HTML_MODEL="deepseek-v4-pro"

AI_INTENT_REQUEST_TIMEOUT_MS="30000"
AI_REQUEST_TIMEOUT_MS="90000"

# Local AI conversation logging for debugging prompts and responses.
AI_CONVERSATION_LOG_ENABLED="true"
AI_CONVERSATION_LOG_TO_CONSOLE="true"
AI_CONVERSATION_LOG_PATH="logs/ai-conversations.log"
AI_CONVERSATION_LOG_MAX_CHARS="20000"

AI_TTS_MODEL="qwen3-tts-flash"
AI_TTS_VOICE="Neil"
AI_TTS_RESPONSE_FORMAT="mp3"
# Optional: override when your AI service exposes TTS at a non-default path.
# Defaults try /audio/speech first, then /tts.
# AI_TTS_PATH="/audio/speech"

# OpenAI-compatible image generation provider for slideshow storyboard images.
# Defaults reuse AI_API_KEY and AI_BASE_URL when IMAGE_API_KEY / IMAGE_API_BASE_URL are omitted.
IMAGE_API_BASE_URL="https://api.openai.com/v1"
IMAGE_API_KEY="your_openai_api_key"
IMAGE_MODEL="gpt-image-1"
# OpenAI official GPT image landscape size. Third-party providers may support larger 16:9 sizes.
IMAGE_SIZE="1536x1024"
