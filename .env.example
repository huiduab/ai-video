# PostgreSQL connection
# Copy this file to .env.local and fill in your real values.
DATABASE_URL="postgresql://postgres:password@localhost:5432/motionweave_ai?schema=public"

# Optional direct connection for migration tools when using a pooler.
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/motionweave_ai?schema=public"

# Runtime configuration
APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI-compatible model provider for the video creation Agent.
AI_BASE_URL="https://your-provider.example.com/v1"
AI_API_KEY="your_api_key"
AI_MODEL="gemini-3-flash-preview"
